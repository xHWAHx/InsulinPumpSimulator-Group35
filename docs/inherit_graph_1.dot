digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node10 [label="QObject",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",tooltip=" "];
  Node10 -> Node0 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node0 [label="BatteryManager",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBatteryManager.html",tooltip="Simulates the battery behavior of the device."];
  Node10 -> Node12 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node12 [label="Bloodstream",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBloodstream.html",tooltip="Simulates insulin activity within the bloodstream."];
  Node10 -> Node13 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node13 [label="DataLogger",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classDataLogger.html",tooltip="Manages data logging for events, glucose, and insulin entries."];
  Node10 -> Node14 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node14 [label="InsulinReserve",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classInsulinReserve.html",tooltip="Manages the insulin reservoir for the pump simulator."];
  Node10 -> Node15 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node15 [label="PumpController",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classPumpController.html",tooltip="controller for insulin pump operations"];
}
