digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node16 [label="QWidget",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",tooltip=" "];
  Node16 -> Node0 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node0 [label="Alert",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classAlert.html",tooltip="The Alert class displays warning or error alerts to the user."];
  Node16 -> Node18 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node18 [label="BolusCalculator",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBolusCalculator.html",tooltip="QWidget subclass for insulin bolus calculation and delivery control."];
  Node16 -> Node19 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node19 [label="History",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classHistory.html",tooltip="Dialog class for displaying the history log."];
  Node16 -> Node20 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node20 [label="Home",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classHome.html",tooltip="The Home class displays the main home screen and CGM glucose chart."];
  Node16 -> Node21 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node21 [label="Login",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classLogin.html",tooltip="The Login class manages PIN entry for unlocking the device."];
  Node16 -> Node22 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node22 [label="Settings",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classSettings.html",tooltip="Widget class for managing personal profiles."];
  Node16 -> Node23 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node23 [label="UserInterface",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classUserInterface.html",tooltip="The UserInterface class manages navigation between screens and updates UI elements."];
}
