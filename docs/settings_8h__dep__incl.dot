digraph "code/settings.h"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="code/settings.h",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Declares the Settings widget for creating and managing user profiles."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="code/userinterface.h",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$userinterface_8h.html",tooltip="Defines the UserInterface class for managing pump UI screens and user interactions."];
  Node2 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="code/alert.h",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$alert_8h.html",tooltip="Defines the Alert system for raising and resetting device alerts."];
  Node3 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="code/device.h",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$device_8h.html",tooltip="Defines the Device class, central orchestrator of the insulin pump simulator."];
  Node2 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
}
