digraph "BolusCalculator"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="BolusCalculator",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="QWidget subclass for insulin bolus calculation and delivery control."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="QWidget",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cgm" ,fontname="Helvetica"];
  Node3 [label="CGMReader",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCGMReader.html",tooltip="Simulates a continuous glucose monitor (CGM)."];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" insulinReserve" ,fontname="Helvetica"];
  Node4 [label="InsulinReserve",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classInsulinReserve.html",tooltip="Manages the insulin reservoir for the pump simulator."];
  Node5 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="QObject",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",tooltip=" "];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" pump" ,fontname="Helvetica"];
  Node6 [label="PumpController",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classPumpController.html",tooltip="controller for insulin pump operations"];
  Node5 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" insulinReserve" ,fontname="Helvetica"];
  Node7 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" logger" ,fontname="Helvetica"];
  Node7 [label="DataLogger",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classDataLogger.html",tooltip="Manages data logging for events, glucose, and insulin entries."];
  Node5 -> Node7 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node8 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" m_logs" ,fontname="Helvetica"];
  Node8 [label="LogData",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structLogData.html",tooltip="Contains all logs."];
  Node7 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" logger" ,fontname="Helvetica"];
}
